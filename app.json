{
  "expo": {
    "name": "LTP Turf Owner",
    "slug": "ltp-turf-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.playltp.ltpturfowner"
    },
    "android": {
      "package": "com.playltp.ltpturfowner",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.playltp.ltpturfowner",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      }
    },
    "owner": "playltpv3",
    "extra": {
      "eas": {
        "projectId": "f36cf45d-4ca3-4a95-a684-1ab4fadff76f"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F7A4C"
        }
      ]
    ]
  }
}
